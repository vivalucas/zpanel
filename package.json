{
  "name": "zpanel",
  "version": "1.1.7",
  "private": false,
  "description": "ZPanel Web",
  "author": "vivalucas",
  "packageManager": "pnpm@11.1.3",
  "keywords": [
    "ZPanel",
    "vue"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-s add-version && run-p type-check build-only",
    "add-version": "node ./scripts/add-frontend-version.js",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "bootstrap": "pnpm install --frozen-lockfile && pnpm run common:prepare",
    "common:cleanup": "rimraf node_modules && rimraf pnpm-lock.yaml",
    "common:prepare": "husky install"
  },
  "dependencies": {
    "@traptitech/markdown-it-katex": "^3.6.0",
    "@vueuse/core": "^14.3.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.21",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.3.0",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@iconify/vue": "^5.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-link-attributes": "^3.0.5",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.5.2",
    "axios": "^1.18.1",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "less": "^4.6.7",
    "lint-staged": "^17.0.8",
    "markdown-it-link-attributes": "^4.0.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.16",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^3.3.6"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "pnpm lint:fix"
    ]
  }
}
