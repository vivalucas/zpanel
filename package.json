{
  "name": "zpanel",
  "version": "1.2.0",
  "private": false,
  "description": "ZPanel Web",
  "author": "vivalucas",
  "packageManager": "pnpm@11.1.3",
  "keywords": [
    "ZPanel",
    "react",
    "homelab"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-s add-version && run-p type-check build-only",
    "add-version": "node ./scripts/add-frontend-version.js",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src scripts tests vite.config.ts playwright.config.ts",
    "lint:fix": "eslint src scripts tests vite.config.ts playwright.config.ts --fix",
    "bootstrap": "pnpm install --frozen-lockfile && pnpm run common:prepare",
    "common:cleanup": "rimraf node_modules && rimraf pnpm-lock.yaml",
    "common:prepare": "husky install",
    "test:review": "node scripts/review-tests.mjs",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "format": "prettier --write src/app src/lib src/components src/features src/main.tsx"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify/react": "^6.0.2",
    "@tanstack/react-query": "^5.102.8",
    "antd": "^6.6.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.15",
    "i18next": "^26.4.2",
    "markdown-it": "^14.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^17.4.4",
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@playwright/test": "^1.63.0",
    "@types/crypto-js": "^4.2.2",
    "@types/markdown-it": "^12.2.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "husky": "^8.0.3",
    "lint-staged": "^17.0.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
